# Copy to .env.local for local development and fill in the values from
# Firebase Console -> Project settings -> General -> Your apps -> Web app config.
# Never commit .env / .env.local. On Render, set these in the dashboard instead.
# These are baked into the bundle at build time (Vite), so changing one on Render needs a redeploy.
# (Firebase web config values are identifiers, not secrets; access is enforced by Firestore rules.)
#
# VITE_FIREBASE_STORAGE_BUCKET is deliberately absent: Firebase Storage is never used.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional, local development only. When true the app talks to the local Auth/Firestore emulators.
# Ignored/refused in production builds.
VITE_USE_EMULATORS=false
VITE_EMULATOR_HOST=127.0.0.1
